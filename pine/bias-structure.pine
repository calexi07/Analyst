// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Forex Fundamental Bias Engine — structure strategy: swing BOS → pullback into discount → internal CHoCH (1H chart).
// Generated automatically: 2026-11-22 11:51 UTC. Bias data: 2026-W40 → 2026-W48 (9 weeks), 14 daily checks.
// Do not edit by hand: the data block is rewritten after every phase and daily check.
// A test bench for your own rules in the Strategy Tester. Not a trade signal.
//@version=6
strategy("Bias Engine · structure (BOS → discount → CHoCH)", shorttitle = "BE Structure", overlay = true, initial_capital = 10000, pyramiding = 0, process_orders_on_close = true, margin_long = 1, margin_short = 1, commission_type = strategy.commission.percent, commission_value = 0.005, slippage = 0, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ───────── settings ─────────
string pairIn  = input.string("Auto", "Pair", options = ["Auto", "EURUSD", "GBPUSD", "USDJPY", "USDCHF", "USDCAD", "AUDUSD", "NZDUSD", "EURGBP", "EURJPY", "EURCHF", "EURAUD", "EURNZD", "EURCAD", "GBPJPY", "GBPCHF", "GBPAUD", "GBPNZD", "GBPCAD", "AUDJPY", "AUDCHF", "AUDNZD", "AUDCAD", "NZDJPY", "NZDCHF", "NZDCAD", "CADJPY", "CADCHF", "CHFJPY", "XAUUSD"], tooltip = "Auto reads the chart symbol. Built for the 1H chart: the pivot lengths below are in candles of the chart.")
string dirMode = input.string("Fundamental bias", "Direction from", options = ["Fundamental bias", "Bias + 20-day SMA agree"], group = "Direction", tooltip = "The week's published bias sets the only direction traded (two-sided weeks do not trade). Simulation (14 pairs, W40–W47): bias only +12.4R on 23 trades; bias + SMA agreement +4.3R on 15.")
string minConv = input.string("Any", "Minimum conviction", options = ["Any", "Medium or high", "High only"], group = "Direction")
int    swLen   = input.int(12, "Swing structure: pivot length (candles each side)", minval = 2, maxval = 50, group = "Structure", tooltip = "Swing highs/lows define the BOS and the impulse leg. 12 on 1H ≈ a 3-candle pivot on 4H. A pivot is only known after this many candles have closed on its right (no repainting).")
int    inLen   = input.int(3, "Internal structure: pivot length", minval = 1, maxval = 20, group = "Structure", tooltip = "Internal highs/lows inside the pullback; the CHoCH is a close beyond the last internal high (long) / low (short) formed in the pullback.")
float  discPct = input.float(50, "Pullback must reach (% of the impulse leg)", minval = 20, maxval = 80, step = 5, group = "Structure", tooltip = "50 = the discount half of the leg from the swing low to the high after the BOS (premium half for shorts).")
int    maxWait = input.int(72, "Setup expires after (candles)", minval = 6, maxval = 300, group = "Structure")
float  slBuf   = input.float(0.1, "Stop buffer beyond the pullback extreme (ATR ×)", minval = 0, maxval = 2, step = 0.05, group = "Exit")
float  maxRisk = input.float(4.0, "Skip if the stop is wider than (ATR ×)", minval = 1, maxval = 20, step = 0.5, group = "Exit")
string tpMode  = input.string("Fixed R", "Take profit", options = ["Fixed R", "Swing liquidity (min 2R)", "None"], group = "Exit", tooltip = "Fixed R: target at the multiple below. Swing liquidity: the last confirmed swing high (long) / low (short) if it is at least 2R away, otherwise the fixed R. Simulation: 3R +12.4R, 2R +10.8R, liquidity +10.4R.")
float  tpR     = input.float(3.0, "Take profit (R)", minval = 0.5, maxval = 10, step = 0.5, group = "Exit")
bool   wkExit  = input.bool(true, "Close every trade at Friday's close", group = "Exit", tooltip = "Simulation: holding over the weekend with a structure trail was worse (−0.9R vs +8.4R in the first test).")
bool   flipEx  = input.bool(true, "Close at the new week if the bias turns against the trade", group = "Exit")
bool   hrsOn   = input.bool(true, "Only enter in my trading hours (Bucharest)", group = "Entry")
int    hrsFrom = input.int(6, "From (hour)", minval = 0, maxval = 23, group = "Entry", inline = "hrs")
int    hrsTo   = input.int(22, "to (hour)", minval = 1, maxval = 24, group = "Entry", inline = "hrs")
bool   noFri   = input.bool(true, "No new entries on Friday", group = "Entry")
int    coolH   = input.int(12, "Hours to wait after an exit", minval = 0, maxval = 240, group = "Entry")
int    fromT   = input.time(timestamp("2000-01-01"), "Trade only from this date", group = "Risk")
float  stRisk  = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, maxval = 5, step = 0.1, group = "Risk")
color  bullC   = input.color(#22AB94, "Bullish", group = "Colours")
color  bearC   = input.color(#F23645, "Bearish", group = "Colours")
bool   zonesOn = input.bool(true, "Show SL / TP zones", group = "Colours")
bool   strOn   = input.bool(true, "Show BOS, discount level and CHoCH", group = "Colours")

// ───────── data (generated) ─────────
