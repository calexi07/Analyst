if barstate.isfirst
    f_data0()
    f_data1()
    f_data2()
    f_data3()
    f_data4()
    f_data5()
    f_data6()
    f_data7()
    f_data8()
    f_data9()
    f_data10()
    f_data11()
    f_data12()
    f_data13()
    f_data14()
    f_data15()
    f_data16()
