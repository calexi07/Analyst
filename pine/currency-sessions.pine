// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © FX Before Coffee · Currency Sessions
// Each currency is marked on the sessions where it is traded at home; a pair shows the sessions of BOTH its currencies.
//   NZD, AUD, JPY → Sydney + Asia (Tokyo)      EUR, GBP, CHF → Frankfurt + London      USD, CAD → New York
//   XAU (gold) → London (with USD it adds New York)
// Session hours are kept in each city's own clock, so summer/winter time changes are handled automatically.
// Times on the chart, labels and dashboard are shown in Romania time (Europe/Bucharest).
//@version=6
indicator("Currency Sessions · FX Before Coffee", "Sessions", overlay = true, max_lines_count = 500, max_labels_count = 500)

TZRO = "Europe/Bucharest"

// ───────── Inputs ─────────
G1 = "Pair"
pairIn = input.string("Auto", "Pair", options = ["Auto", "EURUSD", "GBPUSD", "USDJPY", "USDCHF", "USDCAD", "AUDUSD", "NZDUSD", "EURGBP", "EURJPY", "EURCHF", "EURAUD", "EURNZD", "EURCAD", "GBPJPY", "GBPCHF", "GBPAUD", "GBPNZD", "GBPCAD", "AUDJPY", "AUDCHF", "AUDNZD", "AUDCAD", "NZDJPY", "NZDCHF", "NZDCAD", "CADJPY", "CADCHF", "CHFJPY", "XAUUSD"], group = G1, tooltip = "Auto reads the pair from the chart symbol.")
maxTF  = input.int(60, "Show on timeframes up to (minutes)", minval = 1, maxval = 240, group = G1)

G2 = "Session hours (each city's local time)"
sSyd = input.session("0700-1600", "Sydney (Australia/Sydney)", group = G2)
sTok = input.session("0900-1800", "Asia · Tokyo (Asia/Tokyo)", group = G2)
sFra = input.session("0800-1700", "Frankfurt (Europe/Berlin)", group = G2)
sLon = input.session("0800-1700", "London (Europe/London)", group = G2)
sNy  = input.session("0800-1700", "New York (America/New_York)", group = G2)

G3 = "On the chart"
showBg    = input.bool(true, "Background", group = G3)
showLines = input.bool(true, "Dotted start / end lines", group = G3)
showLbl   = input.bool(true, "Session name at start", group = G3)
showNext  = input.bool(true, "Upcoming sessions (ahead of price)", group = G3)
showDash  = input.bool(true, "Dashboard", group = G3)
dashPosIn = input.string("Top right", "Dashboard position", options = ["Top right", "Top center", "Top left", "Bottom right", "Bottom left"], group = G3)

G4 = "Colours (dark chart)"
cSyd = input.color(#3FB6A8, "Sydney", group = G4)
cTok = input.color(#4FB3BF, "Asia · Tokyo", group = G4)
cFra = input.color(#6C8CF5, "Frankfurt", group = G4)
cLon = input.color(#5B8DEF, "London", group = G4)
cNy  = input.color(#7C83FD, "New York", group = G4)
bgTr = input.int(93, "Background transparency", minval = 80, maxval = 98, group = G4)
lnTr = input.int(45, "Line transparency", minval = 0, maxval = 90, group = G4)
cTxt = input.color(#8A8F98, "Dashboard text", group = G4)

// ───────── Pair → sessions ─────────
f_autoPair() =>
    string s = str.upper(syminfo.basecurrency + syminfo.currency)
    string t = str.upper(syminfo.ticker)
    str.contains(t, "XAU") or str.contains(t, "GOLD") ? "XAUUSD" : s

string pair = pairIn == "Auto" ? f_autoPair() : pairIn
string ccyA = str.length(pair) >= 6 ? str.substring(pair, 0, 3) : ""
string ccyB = str.length(pair) >= 6 ? str.substring(pair, 3, 6) : ""

f_isAsia(string c) => c == "NZD" or c == "AUD" or c == "JPY"
f_isEu(string c)   => c == "EUR" or c == "GBP" or c == "CHF" or c == "XAU"
f_isNy(string c)   => c == "USD" or c == "CAD"

bool useSyd = f_isAsia(ccyA) or f_isAsia(ccyB)
bool useTok = useSyd
bool useFra = (f_isEu(ccyA) and ccyA != "XAU") or (f_isEu(ccyB) and ccyB != "XAU")
bool useLon = f_isEu(ccyA) or f_isEu(ccyB)
bool useNy  = f_isNy(ccyA) or f_isNy(ccyB)
bool known  = useSyd or useLon or useNy
bool tfOk   = timeframe.isintraday and timeframe.in_seconds() <= maxTF * 60

// ───────── In session now (Mon–Fri in each city) ─────────
f_in(string sess, string tz) => not na(time(timeframe.period, sess + ":23456", tz))
bool inSyd = useSyd and f_in(sSyd, "Australia/Sydney")
bool inTok = useTok and f_in(sTok, "Asia/Tokyo")
bool inFra = useFra and f_in(sFra, "Europe/Berlin")
bool inLon = useLon and f_in(sLon, "Europe/London")
bool inNy  = useNy  and f_in(sNy,  "America/New_York")

// ───────── Background ─────────
bgcolor(tfOk and showBg and inSyd ? color.new(cSyd, bgTr) : na, title = "Sydney")
bgcolor(tfOk and showBg and inTok ? color.new(cTok, bgTr) : na, title = "Asia · Tokyo")
bgcolor(tfOk and showBg and inFra ? color.new(cFra, bgTr) : na, title = "Frankfurt")
bgcolor(tfOk and showBg and inLon ? color.new(cLon, bgTr) : na, title = "London")
bgcolor(tfOk and showBg and inNy  ? color.new(cNy,  bgTr) : na, title = "New York")

// ───────── Start / end lines and names on history ─────────
f_mark(bool inS, string name, color c) =>
    bool st = inS and not inS[1]
    bool en = not inS and inS[1]
    if tfOk and showLines and (st or en)
        line.new(time, low, time, high, xloc.bar_time, extend.both, color.new(c, lnTr), line.style_dotted, 1)
    if tfOk and showLbl and st
        label.new(time, high, name + " " + str.format_time(time, "HH:mm", TZRO), xloc.bar_time, yloc.abovebar, color(na), label.style_none, color.new(c, 20), size.tiny)
    st
bool stSyd = f_mark(inSyd, "Sydney", cSyd)
bool stTok = f_mark(inTok, "Asia", cTok)
bool stFra = f_mark(inFra, "Frankfurt", cFra)
bool stLon = f_mark(inLon, "London", cLon)
bool stNy  = f_mark(inNy,  "New York", cNy)

// ───────── Session times for a given day (in the city's clock) ─────────
f_hm(string sess, int part) =>
    // part 0 = start, 1 = end; returns minutes since midnight
    string p = str.substring(sess, part == 0 ? 0 : 5, part == 0 ? 4 : 9)
    int(str.tonumber(str.substring(p, 0, 2))) * 60 + int(str.tonumber(str.substring(p, 2, 4)))
// start and end timestamps of the session on the city's calendar day that contains t (+ dayOff days)
f_times(string sess, string tz, int t, int dayOff) =>
    int t0 = t + dayOff * 86400000
    int y = year(t0, tz)
    int m = month(t0, tz)
    int d = dayofmonth(t0, tz)
    int sM = f_hm(sess, 0)
    int eM = f_hm(sess, 1)
    int ts = timestamp(tz, y, m, d, int(sM / 60), sM % 60)
    int te = timestamp(tz, y, m, d, int(eM / 60), eM % 60)
    [ts, te < ts ? te + 86400000 : te, dayofweek(t0, tz)]

// ───────── Upcoming sessions (ahead of price) ─────────
var array<line>  fl = array.new<line>()
var array<label> fb = array.new<label>()
f_ahead(bool use, string sess, string tz, string name, color c) =>
    if use
        for k = 0 to 2
            [ts, te, dw] = f_times(sess, tz, time, k)
            bool wk = dw != dayofweek.saturday and dw != dayofweek.sunday
            if wk and te > time and ts < time + 30 * 3600000
                if ts > time
                    fl.push(line.new(ts, low, ts, high, xloc.bar_time, extend.both, color.new(c, lnTr), line.style_dotted, 1))
                    if showLbl
                        fb.push(label.new(ts, high, name + " " + str.format_time(ts, "HH:mm", TZRO), xloc.bar_time, yloc.abovebar, color(na), label.style_none, color.new(c, 20), size.tiny))
                fl.push(line.new(te, low, te, high, xloc.bar_time, extend.both, color.new(c, lnTr), line.style_dotted, 1))
    0
if barstate.islast
    for l in fl
        l.delete()
    for b in fb
        b.delete()
    fl.clear()
    fb.clear()
    if tfOk and showNext and known
        f_ahead(useSyd, sSyd, "Australia/Sydney", "Sydney", cSyd)
        f_ahead(useTok, sTok, "Asia/Tokyo", "Asia", cTok)
        f_ahead(useFra, sFra, "Europe/Berlin", "Frankfurt", cFra)
        f_ahead(useLon, sLon, "Europe/London", "London", cLon)
        f_ahead(useNy,  sNy,  "America/New_York", "New York", cNy)

// ───────── Dashboard ─────────
f_pos(string p) =>
    switch p
        "Top center"   => position.top_center
        "Top left"     => position.top_left
        "Bottom right" => position.bottom_right
        "Bottom left"  => position.bottom_left
        => position.top_right
var table dash = table.new(f_pos(dashPosIn), 1, 3, bgcolor = color.new(#0F1115, 15), border_width = 0, frame_color = color.new(#262A33, 0), frame_width = 1)

// "Sydney 23:00–08:00" in Romania time for today's (or the next) session of that city
f_span(string sess, string tz, string name) =>
    string out = ""
    for k = 0 to 3
        [ts, te, dw] = f_times(sess, tz, time, k)
        if out == "" and dw != dayofweek.saturday and dw != dayofweek.sunday and te > time
            out := name + " " + str.format_time(ts, "HH:mm", TZRO) + "–" + str.format_time(te, "HH:mm", TZRO)
    out
if barstate.islast and showDash
    if not known
        table.cell(dash, 0, 0, "Sessions · " + pair + " not recognised", text_color = cTxt, text_size = size.small)
    else
        string act = (inSyd ? "Sydney · " : "") + (inTok ? "Asia · " : "") + (inFra ? "Frankfurt · " : "") + (inLon ? "London · " : "") + (inNy ? "New York · " : "")
        bool anyAct = act != ""
        string list = (useSyd ? f_span(sSyd, "Australia/Sydney", "Syd") + "  " : "") + (useTok ? f_span(sTok, "Asia/Tokyo", "Asia") + "  " : "") + (useFra ? f_span(sFra, "Europe/Berlin", "Fra") + "  " : "") + (useLon ? f_span(sLon, "Europe/London", "Lon") + "  " : "") + (useNy ? f_span(sNy, "America/New_York", "NY") : "")
        table.cell(dash, 0, 0, pair + " · " + ccyA + " + " + ccyB + " sessions (RO time)", text_color = cTxt, text_size = size.tiny, text_halign = text.align_left)
        table.cell(dash, 0, 1, anyAct ? "● ACTIVE  " + str.substring(act, 0, str.length(act) - 3) : "○ no session open", text_color = anyAct ? (inNy ? cNy : inLon ? cLon : inFra ? cFra : inTok ? cTok : cSyd) : cTxt, text_size = size.small, text_halign = text.align_left)
        table.cell(dash, 0, 2, list, text_color = cTxt, text_size = size.tiny, text_halign = text.align_left)

// ───────── Alerts ─────────
bool anyIn = inSyd or inTok or inFra or inLon or inNy
alertcondition(anyIn and not anyIn[1], "Trading time starts", "{{ticker}}: first session of the pair opened")
alertcondition(not anyIn and anyIn[1], "Trading time ends", "{{ticker}}: last session of the pair closed")
alertcondition(stSyd or stTok or stFra or stLon or stNy, "Any session opens", "{{ticker}}: a session of the pair opened")
