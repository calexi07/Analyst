// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Forex Fundamental Bias Engine — supply / demand zones (4H by default) drawn on any chart, coloured by the week's bias.
// Generated automatically: {{GENERATED}}. Bias data: {{COVERAGE}}.
// Do not edit by hand: the data block is rewritten after every phase and daily check.
// Zones are drawn by fixed rules (base + departure). Not a trade signal.
//@version=6
indicator("Bias Engine · supply / demand zones", shorttitle = "BE Zones", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// ───────── settings ─────────
string pairIn  = input.string("Auto", "Pair", options = [{{PAIR_OPTIONS}}], tooltip = "Auto reads the chart symbol. Forex and gold use the weekly fundamental bias; other symbols (indices) use the daily SMA20 trend.")
string zTf     = input.timeframe("240", "Zone timeframe", tooltip = "Zones are built on this timeframe (4H by default) and drawn on any lower chart (1H, 15m, 5m).")
string showDir = input.string("With the bias (others dimmed)", "Which zones", options = ["With the bias only", "With the bias (others dimmed)", "All"], group = "Direction", tooltip = "Test (14 pairs, W40–W47): fresh 4H zones in the bias direction, limit at the proximal line, SL beyond the distal line, TP 3R: 33 trades, +0.74R each; against the bias −0.41R each. Without the bias, on 10 years, zones had no edge.")
string minConv = input.string("Any", "Minimum conviction", options = ["Any", "Medium or high", "High only"], group = "Direction")
float  depM    = input.float(1.2, "Departure candle body ≥ ATR ×", minval = 0.3, maxval = 5, step = 0.1, group = "Zone rules")
int    baseMax = input.int(6, "Base: max candles", minval = 1, maxval = 12, group = "Zone rules")
float  baseB   = input.float(0.5, "Base candle body ≤ ATR ×", minval = 0.1, maxval = 2, step = 0.1, group = "Zone rules")
int    bosLen  = input.int(20, "BOS look-back (zone-TF candles)", minval = 5, maxval = 200, group = "Zone rules", tooltip = "The departure breaks structure if it closes beyond the highest high / lowest low of these candles before the base. Shown as ★ in the label.")
int    maxZ    = input.int(12, "Max zones on chart", minval = 1, maxval = 40, group = "Display")
bool   keepT   = input.bool(true, "Keep touched zones (grey) until invalidated", group = "Display", tooltip = "Fresh zones are coloured; after the first touch the zone turns grey (no longer fresh). A close of a zone-TF candle beyond the distal line removes the zone.")
bool   showLbl = input.bool(true, "Labels (type, strength, BOS)", group = "Display")
color  dCol    = input.color(color.new(#22AB94, 75), "Demand", group = "Display")
color  sCol    = input.color(color.new(#F23645, 75), "Supply", group = "Display")
color  tCol    = input.color(color.new(#787B86, 85), "Touched", group = "Display")
int    trLen   = input.int(20, "Trend SMA length (daily closes)", minval = 5, maxval = 200, group = "Direction")

// ───────── data (generated) ─────────
var string[] PAIRS = array.from({{PAIRS}})
var string[] CCY   = array.from({{CCY}})
var int[]    wT = array.new_int()
var string[] wN = array.new_string()
var string[] wD = array.new_string()
var string[] wS = array.new_string()
var int[]    cT = array.new_int()
var string[] cN = array.new_string()
var string[] cD = array.new_string()
var string[] cH = array.new_string()
var string[] cC = array.new_string()
{{DATA}}

// ───────── helpers ─────────
f_item(string row, int i) =>
    string[] parts = str.split(row, ",")
    i >= 0 and i < array.size(parts) ? array.get(parts, i) : "?"
f_bname(string b) => b == "U" ? "BULLISH" : b == "D" ? "BEARISH" : b == "N" ? "TWO-SIDED" : "none"
f_cname(string c) => c == "h" ? "high" : c == "m" ? "medium" : c == "l" ? "low" : "-"
f_sg(float v) => na(v) ? "0" : v > 0 ? "+" + str.tostring(v) : str.tostring(v)
f_sname(string s) => s == "C" ? "Confirmed" : s == "S" ? "Confirmed, could get stronger" : s == "F" ? "Confirmed but fragile" : s == "W" ? "Under watch" : s == "P" ? "Under pressure" : s == "X" ? "Invalidated" : s == "T" ? "Still two-sided" : "none"
f_wa(bool ok) => ok ? "with" : "against"
var string[] DOW = array.from("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")

// ───────── pair and week ─────────
string symA = syminfo.basecurrency + syminfo.currency
string tk   = str.upper(syminfo.ticker)
string symB = str.length(tk) >= 6 ? str.substring(tk, 0, 6) : tk
int pIdx = pairIn != "Auto" ? array.indexof(PAIRS, pairIn) : array.indexof(PAIRS, symA) >= 0 ? array.indexof(PAIRS, symA) : array.indexof(PAIRS, symB)
string pName = pIdx >= 0 ? array.get(PAIRS, pIdx) : syminfo.ticker
float pipSz = str.contains(pName, "JPY") ? 0.01 : str.contains(pName, "XAU") ? 0.1 : 0.0001
f_pips(float d) => math.round(d / pipSz * 10) / 10

int WEEK_MS = 7 * 86400000
var int wi = -1
while wi + 1 < array.size(wT) and time >= array.get(wT, wi + 1)
    wi += 1
bool inWk = wi >= 0 and time < array.get(wT, math.max(wi, 0)) + WEEK_MS
string rec = inWk and pIdx >= 0 ? f_item(array.get(wD, math.max(wi, 0)), pIdx) : "?"
bool hasRec = rec != "?" and str.length(rec) >= 2
string b  = hasRec ? str.substring(rec, 0, 1) : "-"
string cv = hasRec ? str.substring(rec, 1, 2) : "-"
float  g  = hasRec and str.length(rec) > 2 ? str.tonumber(str.substring(rec, 2)) : na

// ───────── direction ─────────
[smaT, dCl] = request.security(syminfo.tickerid, "D", [ta.sma(close, trLen)[1], close[1]], lookahead = barmerge.lookahead_on)
int biasDir = b == "U" ? 1 : b == "D" ? -1 : 0
bool convOk = minConv == "Any" or (minConv == "High only" ? cv == "h" : cv == "h" or cv == "m")
int tDir = na(smaT) or na(dCl) ? 0 : dCl > smaT ? 1 : dCl < smaT ? -1 : 0
bool isFx = pIdx >= 0
int dir = isFx ? (convOk ? biasDir : 0) : tDir

// ───────── zone detection (runs on the zone timeframe) ─────────
// departure = the zone-TF candle; base = the run of small-body candles right before it
f_zone() =>
    float A = ta.atr(14)
    float hh = ta.highest(high, bosLen)
    float ll = ta.lowest(low, bosLen)
    float body = close - open
    float rng = high - low
    int d = 0
    float prox = na
    float dist = na
    float strength = na
    bool bosOk = false
    int nb = 0
    bool rev = false
    if not na(A) and math.abs(body) >= depM * A and rng > 0 and math.abs(body) / rng >= 0.6
        int n = 0
        for i = 1 to baseMax
            if not na(A[i]) and math.abs(close[i] - open[i]) <= baseB * A[i]
                n += 1
            else
                break
        if n > 0
            float top = math.max(open[1], close[1])
            float bot = math.min(open[1], close[1])
            float lo = low
            float hi = high
            for i = 1 to n
                top := math.max(top, math.max(open[i], close[i]))
                bot := math.min(bot, math.min(open[i], close[i]))
                lo := math.min(lo, low[i])
                hi := math.max(hi, high[i])
            d := body > 0 ? 1 : -1
            prox := d > 0 ? top : bot
            dist := d > 0 ? lo : hi
            strength := math.abs(close - prox) / A
            bosOk := d > 0 ? close > hh[n + 1] : close < ll[n + 1]
            nb := n
            rev := d > 0 ? close[n + 1] < open[n + 1] : close[n + 1] > open[n + 1]
    [d, prox, dist, strength, bosOk, nb, rev]
// values of the zone-TF candle that has just closed (no repaint)
f_prev() =>
    [d, p, x, s, bo, n, r] = f_zone()
    [d[1], p[1], x[1], s[1], bo[1], n[1], r[1], time[1], close[1]]
[zd, zp, zx, zs, zb, zn, zr, zT0, zC] = request.security(syminfo.tickerid, zTf, f_prev(), lookahead = barmerge.lookahead_on)
int tfMs = timeframe.in_seconds(zTf) * 1000

// ───────── zones on the chart ─────────
var array<int>   aD = array.new<int>()
var array<float> aP = array.new<float>()
var array<float> aX = array.new<float>()
var array<int>   aT = array.new<int>()
var array<bool>  aTouch = array.new<bool>()
var array<bool>  aWith = array.new<bool>()
var array<box>   aBox = array.new<box>()
var array<label> aLbl = array.new<label>()
f_drop(int i) =>
    box.delete(array.get(aBox, i))
    label.delete(array.get(aLbl, i))
    array.remove(aD, i)
    array.remove(aP, i)
    array.remove(aX, i)
    array.remove(aT, i)
    array.remove(aTouch, i)
    array.remove(aWith, i)
    array.remove(aBox, i)
    array.remove(aLbl, i)
bool newHtf = ta.change(zT0) != 0 and not na(zT0)
if newHtf
    // a zone-TF close beyond the distal line removes the zone
    if array.size(aD) > 0
        for i = array.size(aD) - 1 to 0
            if zT0 > array.get(aT, i) and (zC - array.get(aX, i)) * array.get(aD, i) < 0
                f_drop(i)
    if zd != 0 and not na(zp) and not na(zx)
        bool withB = dir == zd
        bool show = showDir == "All" or withB or showDir == "With the bias (others dimmed)"
        if show
            color c = zd > 0 ? dCol : sCol
            if not withB
                c := color.new(c, 92)
            int left = zT0 - zn * tfMs
            box bx = box.new(left, math.max(zp, zx), time + tfMs, math.min(zp, zx), xloc = xloc.bar_time, extend = extend.right, bgcolor = c, border_color = color.new(c, 40))
            string kind = zd > 0 ? (zr ? "DBR" : "RBR") : (zr ? "RBD" : "DBD")
            label lb = showLbl ? label.new(left, zd > 0 ? math.min(zp, zx) : math.max(zp, zx), (zd > 0 ? "Demand " : "Supply ") + kind + " · " + str.tostring(zs, "#.0") + "×ATR" + (zb ? " ★BOS" : "") + (withB ? "" : " · against bias"), xloc = xloc.bar_time, style = zd > 0 ? label.style_label_upper_left : label.style_label_lower_left, color = color(na), textcolor = color.new(zd > 0 ? #22AB94 : #F23645, withB ? 0 : 50), size = size.tiny) : na
            array.push(aD, zd)
            array.push(aP, zp)
            array.push(aX, zx)
            array.push(aT, zT0)
            array.push(aTouch, false)
            array.push(aWith, withB)
            array.push(aBox, bx)
            array.push(aLbl, lb)
            if array.size(aD) > maxZ
                f_drop(0)
// first touch of the proximal line (on the chart's candles, after the zone-TF candle closed)
if array.size(aD) > 0
    for i = array.size(aD) - 1 to 0
        if not array.get(aTouch, i) and time >= array.get(aT, i) + tfMs
            int d = array.get(aD, i)
            float p = array.get(aP, i)
            if d > 0 ? low <= p : high >= p
                array.set(aTouch, i, true)
                if array.get(aWith, i)
                    alert("BE Zones · " + pName + " · first touch of a fresh " + (zTf == "240" ? "4H" : zTf) + (d > 0 ? " DEMAND " : " SUPPLY ") + str.tostring(p, format.mintick) + " / " + str.tostring(array.get(aX, i), format.mintick) + " (with the bias)", alert.freq_once_per_bar_close)
                if keepT
                    box.set_bgcolor(array.get(aBox, i), tCol)
                    box.set_border_color(array.get(aBox, i), color.new(tCol, 40))
                else
                    f_drop(i)

var table tb = table.new(position.top_right, 2, 2, bgcolor = color.new(#1E222D, 10), border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, "BE Zones · " + pName, text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, (zTf == "240" ? "4H" : zTf) + " zones", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, isFx ? "Bias" : "SMA20 trend", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 1, isFx ? f_bname(b) + " " + f_cname(cv) + " " + f_sg(g) : (tDir > 0 ? "up" : tDir < 0 ? "down" : "–"), text_color = dir > 0 ? #22AB94 : dir < 0 ? #F23645 : color.gray, text_size = size.small)
