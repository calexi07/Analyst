// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Forex Fundamental Bias Engine — swing strategy test bench (4H or Daily chart, holds 3–4 days).
// Generated automatically: {{GENERATED}}. Bias data: {{COVERAGE}}.
// Do not edit by hand: the data block is rewritten after every phase and daily check.
// A test bench for your own rules in the Strategy Tester. Not a trade signal.
//@version=6
strategy("Bias Engine · swing test bench", shorttitle = "BE Swing", overlay = true, initial_capital = 10000, pyramiding = 0, process_orders_on_close = true, margin_long = 1, margin_short = 1, commission_type = strategy.commission.percent, commission_value = 0.005, slippage = 0, max_labels_count = 500, max_boxes_count = 500)

// ───────── settings ─────────
string pairIn  = input.string("Auto", "Pair", options = [{{PAIR_OPTIONS}}], tooltip = "Auto reads the chart symbol (e.g. EURUSD, OANDA:XAUUSD). Built for the 4H chart (Daily works too). Days below are calendar time, so they mean the same on any timeframe.")
string sigTf   = input.string("4H", "Signal timeframe", options = ["Chart", "4H", "1H", "15m", "Daily"], tooltip = "The candles the strategy reads (sweeps, breaks, ATR, trailing). 4H on a 5m or 15m chart: the 4H strategy runs exactly as on the 4H chart, but you see the entries and exits on the lower chart, and stops, targets and entry orders fill on the real 5m path. Chart: use the chart's own candles. Lower charts have less history in TradingView (5m ≈ a few months).")
string dirMode = input.string("Both must agree", "Direction from", options = ["Fundamental bias", "Price trend (SMA)", "Both must agree"], group = "Direction", tooltip = "Fundamental bias: the week's published bias (data only from the first week in the script). Price trend: close above / below the SMA below, works on years of history, so the mechanics can be tested on thousands of trades. Both: only when the two agree.")
string minConv = input.string("Any", "Minimum conviction", options = ["Any", "Medium or high", "High only"], group = "Direction", tooltip = "Bias modes only. Two-sided weeks never trade.")
int    trLen   = input.int(20, "Trend SMA length (daily closes)", minval = 5, maxval = 400, group = "Direction")
string cfMode  = input.string("Close vs 20-day SMA", "Price confirmation", options = ["None", "Week-to-date", "Close vs 20-day SMA"], group = "Confirmation", tooltip = "Week-to-date: the day's close is above this week's open for longs (below for shorts); Monday's close is the first that can confirm, so the earliest entry is Tuesday. 20-day SMA: the close is on the trade's side of the 20-day average.")
string enMode  = input.string("C · break of the confirming candle's high/low", "Entry", options = ["S · sweep of yesterday's low/high + reclaim", "SD · sweep, else break of yesterday's high/low", "D · break of yesterday's high/low", "A · at the confirming candle's close", "B · pullback to 50% of the confirming candle", "C · break of the confirming candle's high/low"], group = "Entry", tooltip = "S: a 4H candle trades below yesterday's low (long) / above yesterday's high (short) and closes back on the other side; entry at its close. SD: the same sweep enters at once; otherwise a stop order waits at yesterday's high (long) / low (short) for the next candle. D: only that stop order. A/B/C: the earlier entries at, inside or beyond the confirming candle. Backtest on the USD pairs, bias weeks W40–W47: S +19R, SD +18R, A +15R; on 3 years without bias: D +73R, SD +46R, S +9R (the sweep needs the fundamental direction).")
string scMode  = input.string("None", "Signal candle filter", options = ["None", "Closed in the trade's direction", "Close beyond the 20 EMA"], group = "Entry", tooltip = "Extra condition on the signal candle (4H when Signal timeframe = 4H). Closed in the trade's direction: bullish candle for longs, bearish for shorts. Close beyond the 20 EMA: the candle closes above the 20 EMA of the signal timeframe for longs, below for shorts. Simulation (entry C, USD pairs W40–W47, with trailing tightened after +2R and TP 4R): direction filter +55.5R vs +52.7R without, drawdown −4.5R vs −3.2R; EMA filter +37.9R but the most stable on 3 years of trend-direction tests (positive every year).")
string opMode  = input.string("None", "Price on the trade's side of", options = ["None", "Week open", "Week + month open", "Week + month + year open"], group = "Entry", tooltip = "Long only above these opens, short only below. On 3 years it helped the technical entries (D), on the bias weeks it changed little.")
bool   noFri   = input.bool(true, "No new entries on Friday", group = "Entry", tooltip = "Fridays would open a trade into the weekend and into next week's new bias.")
bool   noThu   = input.bool(true, "No new entries on Thursday", group = "Entry", tooltip = "A Thursday trade has only one day left before Friday's close. Backtest (sweep + bias, USD pairs, W40–W47): Thursday entries made 0R on 9 trades; without them the worst drawdown fell from −2.5R to −2.0R, and on 3 years of trend-direction tests the result rose from +9R to +14R.")
bool   hrsOn   = input.bool(true, "Only fill entries in my trading hours (Bucharest)", group = "Entry", tooltip = "Entry orders fill only between the hours below (Europe/Bucharest); outside them pending orders are paused and come back inside the window while the signal candle still allows it, and a market entry due outside is skipped. Open trades are not affected. Exact on a 5m/15m/1H chart with Signal timeframe 4H; on the 4H chart itself a candle that opens outside the hours (e.g. 04:00) places no order. Simulation on the 1H path (USD pairs W40–W47, TP 4R, trailing tightened after +2R): 06–22 gave +52.7R vs +55.0R on all hours.")
int    hrsFrom = input.int(6, "From (hour)", minval = 0, maxval = 23, group = "Entry", inline = "hrs")
int    hrsTo   = input.int(22, "to (hour)", minval = 1, maxval = 24, group = "Entry", inline = "hrs")
bool   noRoll  = input.bool(false, "No entries 23:00–01:00 (rollover, Bucharest time)", group = "Entry", tooltip = "Spreads widen around the daily rollover (00:00 Bucharest), so a stop entry can be hit by the spread alone. On a 5m chart with 4H signals: pending entry orders are paused 23:00–01:00 and come back after 01:00 while the signal candle still allows it; a market entry due in that window is skipped. On the 4H chart: the candle closing at 00:00 places no order (its order would fill 00:00–04:00). Backtest (USD pairs W40–W47): fills in the 00:00–04:00 candle made +0.2R on 4 trades, so the filter changes little on bid prices; it protects against real spreads.")
int    coolH   = input.int(24, "Hours to wait after an exit", minval = 0, maxval = 240, group = "Entry", tooltip = "No new trade on this pair for this many hours after a trade closes (0 = the next candle).")
string slMode  = input.string("ATR × multiple", "Stop loss", options = ["ATR × multiple", "Beyond the confirming candle's low/high"], group = "Exit")
float  slAtr   = input.float(1.0, "ATR multiple", minval = 0.3, maxval = 5, step = 0.1, group = "Exit")
string atrTf   = input.string("Chart ATR (14)", "ATR from", options = ["Daily ATR (14)", "Chart ATR (14)"], group = "Exit", tooltip = "Daily ATR sizes the stop for a 3–4 day hold whatever the chart timeframe (≈ one normal day's range). Chart ATR on 4H gives a much tighter stop.")
string exMode  = input.string("Fixed (one target)", "Exit style", options = ["Half at +1R, rest at break-even", "Fixed (one target)"], group = "Exit", tooltip = "Half at +1R: half the position closes at +1R, the stop of the other half moves to the entry price, and it runs to the take profit below, the time stop or Friday's close. Fixed: the whole position has one stop and one target. Backtest on the USD pairs: the half-at-1R exit cut the worst drawdown from −10R to −4R and was better in both halves of the bias weeks.")
float  tpR     = input.float(4.0, "Take profit (R), 0 = none", minval = 0, maxval = 10, step = 0.5, group = "Exit", tooltip = "For the half-at-1R style this is the target of the second half (0 = no target). Defaults are the user's tested set (21 Nov): Fixed exit, TP 4R, trailing from the close 0.75 × 4H ATR tightened to 0.5 after +2R, entry C, both bias and SMA20 must agree, entries 06–22 Bucharest. Simulated on the 1H path, USD pairs W40–W47: +52.7R, worst drawdown −5.6R; TradingView EURUSD +15.7R (forward test still needed). For the fixed style it is the target of the whole position (earlier default: 2R).")
int    hold    = input.int(0, "Time stop: close after this many days (0 = hold to Friday)", minval = 0, maxval = 20, group = "Exit", tooltip = "Tested: hold to Friday with the half-at-1R exit; 4 days with the fixed exit.")
bool   wkExit  = input.bool(true, "Close every trade at Friday's close", group = "Exit")
bool   flipEx  = input.bool(true, "Close if the direction turns against the trade", group = "Exit")
string trMode  = input.string("From the close (always on)", "Trailing stop", options = ["Chandelier after +1R", "From the close (always on)", "Off"], group = "Exit", tooltip = "Chandelier: once the trade has been +1R in profit, the stop follows the best price reached since entry at the distance below (daily ATR ×). It only moves in the trade's favour. Backtest (sweep + bias, USD pairs, W40–W47), second half trailed at 0.75 ATR with no target, plus no Thursday entries: +21.1R vs +19.3R, worst drawdown −2.0R vs −2.5R, every 2-week block ≥ +3.2R. Small sample (35 trades): treat as a forward test. From the close: the older trailing stop, a fixed distance from each candle's close.")
float  trAtr   = input.float(0.75, "Trailing distance (ATR ×)", minval = 0.25, maxval = 6, step = 0.05, group = "Exit")
float  trTight = input.float(0.5, "Tighten the trailing to (ATR ×), 0 = off", minval = 0, maxval = 6, step = 0.05, group = "Exit", tooltip = "Once the trade has been this many R in profit (below), the trailing distance changes to this value. Simulation (entry C, USD pairs W40–W47): 0.75 tightened to 0.5 after +2R gave +47.8R vs +43.5R with the same −3.2R drawdown; with TP 4R +52.7R. Better on 3 years of trend-direction tests too (+41R vs +25R).")
float  trTightR = input.float(2.0, "…after this profit (R)", minval = 0.5, maxval = 10, step = 0.25, group = "Exit")
bool   trOn    = trMode != "Off"
int    fromT   = input.time(timestamp("2000-01-01"), "Trade only from this date", group = "Risk", tooltip = "Set it to the first bias week (e.g. 1 Oct 2026) to compare 'Price trend' and 'Fundamental bias' on exactly the same weeks.")
float  stRisk  = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, maxval = 5, step = 0.1, group = "Risk")
color  bullC   = input.color(#22AB94, "Bullish", group = "Colours")
color  bearC   = input.color(#F23645, "Bearish", group = "Colours")
bool   zonesOn = input.bool(true, "Show SL / TP zones", group = "Colours", tooltip = "Red box: entry to stop (turns grey once the trailing stop has locked in profit). Green box: entry to take profit. Drawn for every trade.")

// ───────── data (generated) ─────────
var string[] PAIRS = array.from({{PAIRS}})
var string[] CCY   = array.from({{CCY}})
var int[]    wT = array.new_int()
var string[] wN = array.new_string()
var string[] wD = array.new_string()
var string[] wS = array.new_string()
var int[]    cT = array.new_int()
var string[] cN = array.new_string()
var string[] cD = array.new_string()
var string[] cH = array.new_string()
var string[] cC = array.new_string()
{{DATA}}

// ───────── helpers ─────────
f_item(string row, int i) =>
    string[] parts = str.split(row, ",")
    i >= 0 and i < array.size(parts) ? array.get(parts, i) : "?"
f_bname(string b) => b == "U" ? "BULLISH" : b == "D" ? "BEARISH" : b == "N" ? "TWO-SIDED" : "none"
f_cname(string c) => c == "h" ? "high" : c == "m" ? "medium" : c == "l" ? "low" : "-"
f_sg(float v) => na(v) ? "0" : v > 0 ? "+" + str.tostring(v) : str.tostring(v)
f_sname(string s) => s == "C" ? "Confirmed" : s == "S" ? "Confirmed, could get stronger" : s == "F" ? "Confirmed but fragile" : s == "W" ? "Under watch" : s == "P" ? "Under pressure" : s == "X" ? "Invalidated" : s == "T" ? "Still two-sided" : "none"
f_wa(bool ok) => ok ? "with" : "against"
var string[] DOW = array.from("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")

// ───────── pair and week ─────────
string symA = syminfo.basecurrency + syminfo.currency
string tk   = str.upper(syminfo.ticker)
string symB = str.length(tk) >= 6 ? str.substring(tk, 0, 6) : tk
int pIdx = pairIn != "Auto" ? array.indexof(PAIRS, pairIn) : array.indexof(PAIRS, symA) >= 0 ? array.indexof(PAIRS, symA) : array.indexof(PAIRS, symB)
string pName = pIdx >= 0 ? array.get(PAIRS, pIdx) : syminfo.ticker
float pipSz = str.contains(pName, "JPY") ? 0.01 : str.contains(pName, "XAU") ? 0.1 : 0.0001
f_pips(float d) => math.round(d / pipSz * 10) / 10

int WEEK_MS = 7 * 86400000
var int wi = -1
while wi + 1 < array.size(wT) and time >= array.get(wT, wi + 1)
    wi += 1
bool inWk = wi >= 0 and time < array.get(wT, math.max(wi, 0)) + WEEK_MS
string rec = inWk and pIdx >= 0 ? f_item(array.get(wD, math.max(wi, 0)), pIdx) : "?"
bool hasRec = rec != "?" and str.length(rec) >= 2
string b  = hasRec ? str.substring(rec, 0, 1) : "-"
string cv = hasRec ? str.substring(rec, 1, 2) : "-"
float  g  = hasRec and str.length(rec) > 2 ? str.tonumber(str.substring(rec, 2)) : na

// latest daily check for this pair up to this bar
var int ci = -1
while ci + 1 < array.size(cT) and time >= array.get(cT, ci + 1)
    ci += 1
string ck = ci >= 0 and pIdx >= 0 ? f_item(array.get(cD, math.max(ci, 0)), pIdx) : "?"
string ckS = ck == "?" or ci < 0 or time - array.get(cT, math.max(ci, 0)) > 3 * 86400000 ? "none" : f_sname(str.substring(ck, 0, 1))

// ───────── direction and confirmation (all known at this day's close) ─────────
// daily values of the previous completed day (no lookahead), so they mean the same on 4H and Daily
[dAtr, smaT, sma20, pdH, pdL] = request.security(syminfo.tickerid, "D", [ta.atr(14)[1], ta.sma(close, trLen)[1], ta.sma(close, 20)[1], high[1], low[1]], lookahead = barmerge.lookahead_on)
float mO = request.security(syminfo.tickerid, "M", open, lookahead = barmerge.lookahead_on)
float yO = request.security(syminfo.tickerid, "12M", open, lookahead = barmerge.lookahead_on)
// signal candles: the chart's own, or completed higher-timeframe candles read on a lower chart (e.g. 4H on 5m)
string tfS = sigTf == "4H" ? "240" : sigTf == "1H" ? "60" : sigTf == "15m" ? "15" : sigTf == "Daily" ? "D" : timeframe.period
bool htfMode = timeframe.in_seconds(tfS) > timeframe.in_seconds()
[sO, sH, sL, sC, sA, sE, sTc] = request.security(syminfo.tickerid, tfS, [open, high, low, close, ta.atr(14), ta.ema(close, 20), time_close], lookahead = barmerge.lookahead_on)
// the last lower-timeframe bar of each signal candle: its close is the signal candle's close, so the values are complete (no lookahead)
bool sBar = not htfMode or (not na(sTc) and time_close >= sTc)
var float kH = na
var float kL = na
var float kC = na
var float kA = na
var float kO = na
var float kE = na
if htfMode and sBar
    kH := sH
    kL := sL
    kC := sC
    kA := sA
    kO := sO
    kE := sE
float hiS = htfMode ? kH : high
float loS = htfMode ? kL : low
float clS = htfMode ? kC : close
float chAtr = ta.atr(14)
float chEma = ta.ema(close, 20)
float opS = htfMode ? kO : open
float emS = htfMode ? kE : chEma
float cAtr = htfMode ? kA : chAtr
float atr = atrTf == "Daily ATR (14)" ? dAtr : cAtr
// trading day in New York terms (the FX day starts at 17:00 New York)
int NY7 = 7 * 3600000
int tDay = dayofweek(time + NY7, "America/New_York")
int fri17 = timestamp("America/New_York", year(time + NY7, "America/New_York"), month(time + NY7, "America/New_York"), dayofmonth(time + NY7, "America/New_York"), 17, 0)
bool lastWkBar = tDay == dayofweek.friday and time_close + timeframe.in_seconds() * 1000 > fri17
[wkO, wkT0] = request.security(syminfo.tickerid, "W", [open, time], lookahead = barmerge.lookahead_on)

int biasDir = b == "U" ? 1 : b == "D" ? -1 : 0
bool convOk = minConv == "Any" or (minConv == "High only" ? cv == "h" : cv == "h" or cv == "m")
int bDir = convOk ? biasDir : 0
int tDir = na(smaT) or na(clS) ? 0 : clS > smaT ? 1 : clS < smaT ? -1 : 0
int dir = dirMode == "Fundamental bias" ? bDir : dirMode == "Price trend (SMA)" ? tDir : (bDir == tDir ? bDir : 0)

bool wtdUp = clS > wkO
bool wtdDn = clS < wkO
bool smUp = not na(sma20) and clS > sma20
bool smDn = not na(sma20) and clS < sma20
bool opOk = opMode == "None" or (dir > 0 ? (clS > wkO and (opMode == "Week open" or clS > mO) and (opMode != "Week + month + year open" or clS > yO)) : (clS < wkO and (opMode == "Week open" or clS < mO) and (opMode != "Week + month + year open" or clS < yO)))
bool cfOk = cfMode == "None" or (cfMode == "Week-to-date" ? (dir > 0 ? wtdUp : wtdDn) : (dir > 0 ? smUp : smDn))
bool dayOk = not (noFri and tDay == dayofweek.friday) and not (noThu and tDay == dayofweek.thursday) and tDay != dayofweek.saturday and tDay != dayofweek.sunday and not lastWkBar

// ───────── orders ─────────
var float slLvl = na
var float tpLvl = na
var int   lastExitT = 0
var int   posDir = 0
var float ent0 = na
var float risk0 = na
var float q0 = na
var bool  partDone = false
var box   zSl = na
var box   zTp = na
var int   zEb = -1
var float bestP = na
// a pending entry: placed now, or paused during the rollover and placed again after it
var bool  pLive = false
var float pE = na
var float pQ = na
var int   pDir = 0
var int   pKind = 0
var string pCmt = ""
bool halfOn = exMode == "Half at +1R, rest at break-even"
bool flat = strategy.position_size == 0

if not flat and posDir == 0
    posDir := strategy.position_size > 0 ? 1 : -1
    pLive := false
    // ent0 / risk0 / q0 are set when the order is placed (if the half already filled on the entry's next candle, the position is smaller here)
    partDone := false
    bestP := na
if flat and posDir != 0
    if not na(zSl)
        box.set_right(zSl, bar_index)
    if not na(zTp)
        box.set_right(zTp, bar_index)
    posDir := 0
    lastExitT := time

// rollover window 23:00–01:00 Bucharest
f_inRoll(int t) =>
    int h = hour(t, "Europe/Bucharest")
    h == 23 or h == 0
// true when the next bar opens inside the window (orders placed or kept now would fill there)
// outside the trader's hours (the next bar opens outside From–To, Bucharest)
f_outHrs(int t) =>
    int h = hour(t, "Europe/Bucharest")
    h < hrsFrom or h >= hrsTo
bool rollNow = (noRoll and f_inRoll(time_close)) or (hrsOn and f_outHrs(time_close))

// pending orders live one signal candle
if flat and sBar
    strategy.cancel("L")
    strategy.cancel("S")
    pLive := false

bool scOk = scMode == "None" or (scMode == "Closed in the trade's direction" ? (clS - opS) * dir > 0 : not na(emS) and (clS - emS) * dir > 0)
bool sig = flat and sBar and time >= fromT and dir != 0 and cfOk and opOk and scOk and dayOk and time - lastExitT >= coolH * 3600000 and not na(atr)
if sig
    string ek = array.get(str.split(enMode, " "), 0)
    bool sweepOk = not na(pdL) and (dir > 0 ? (loS < pdL and clS > pdL) : (hiS > pdH and clS < pdH))
    float brk = dir > 0 ? pdH : pdL
    bool brkOk = not na(brk) and (brk - clS) * dir > 0
    // kind: 0 market at the close, 1 limit, 2 stop; go = this candle gives an order
    int kind = ek == "A" ? 0 : ek == "B" ? 1 : ek == "C" ? 2 : ek == "S" ? 0 : ek == "D" ? 2 : (sweepOk ? 0 : 2)
    bool go = ek == "S" ? sweepOk : ek == "D" ? brkOk : ek == "SD" ? (sweepOk or brkOk) : true
    float ent = ek == "A" or ((ek == "S" or ek == "SD") and sweepOk) ? clS : ek == "B" ? (hiS + loS) / 2 : ek == "C" ? (dir > 0 ? hiS + syminfo.mintick : loS - syminfo.mintick) : brk
    bool isA = kind == 0
    bool isB = kind == 1
    float sl = slMode == "ATR × multiple" ? ent - dir * slAtr * atr : (dir > 0 ? loS - 0.1 * atr : hiS + 0.1 * atr)
    float risk = math.abs(ent - sl)
    if go and risk > 0 and (dir > 0 ? sl < ent : sl > ent)
        float qRaw = strategy.equity * stRisk / 100 / (risk * syminfo.pointvalue)
        // an even size, so the two halves are equal and no 1-unit remainder is left behind
        // large sizes (FX units) are rounded to an even number; small sizes (gold ounces, indices) keep 2 decimals, so the risk stays at 1%
        float q = halfOn and qRaw >= 20 ? math.floor(qRaw / 2) * 2 : math.round(qRaw, 2)
        ent0 := ent
        risk0 := risk
        q0 := q
        string cmt = pName + " | " + (dir > 0 ? "long" : "short") + " | bias " + f_bname(b) + " " + f_cname(cv) + " gap " + f_sg(g) + " | trend " + f_wa(dir == tDir) + " | wtd " + f_wa(dir > 0 ? wtdUp : wtdDn) + " | sma20 " + f_wa(dir > 0 ? smUp : smDn) + " | check " + ckS + " | entry " + (ek == "SD" ? (sweepOk ? "SD-sweep" : "SD-break") : ek) + " | SL " + str.tostring(f_pips(risk)) + "p | dir " + dirMode + " | " + array.get(DOW, tDay - 1) + " " + (htfMode ? tfS + " on " + timeframe.period : timeframe.period)
        slLvl := sl
        tpLvl := tpR > 0 ? ent + dir * tpR * risk : na
        pLive := not (rollNow and kind == 0)
        pE := ent
        pQ := q
        pDir := dir
        pKind := kind
        pCmt := cmt

// place (or re-place) the pending entry and its exits; paused during the rollover window
if flat and pLive and rollNow
    strategy.cancel("L")
    strategy.cancel("S")
else if flat and pLive
    string id = pDir > 0 ? "L" : "S"
    if pKind == 0
        strategy.entry(id, pDir > 0 ? strategy.long : strategy.short, qty = pQ, comment = pCmt)
        pLive := false
    else if pKind == 1
        strategy.entry(id, pDir > 0 ? strategy.long : strategy.short, qty = pQ, limit = pE, comment = pCmt)
    else
        strategy.entry(id, pDir > 0 ? strategy.long : strategy.short, qty = pQ, stop = pE, comment = pCmt)
    if halfOn
        strategy.exit("H" + id, id, qty_percent = 50, stop = slLvl, limit = pE + pDir * risk0, comment_loss = "SL", comment_profit = "+1R half")
        strategy.exit("X" + id, id, qty_percent = 50, stop = slLvl, limit = tpLvl, comment_loss = "SL", comment_profit = "TP")
    else
        strategy.exit("X" + id, id, stop = slLvl, limit = tpLvl, comment_loss = "SL", comment_profit = "TP")

if not flat
    string id = posDir > 0 ? "L" : "S"
    int held = strategy.opentrades > 0 ? time_close - strategy.opentrades.entry_time(0) : 0
    bestP := na(bestP) ? (posDir > 0 ? high : low) : posDir > 0 ? math.max(bestP, high) : math.min(bestP, low)
    bool trLive = trMode == "From the close (always on)" or (trMode == "Chandelier after +1R" and (bestP - ent0) * posDir >= risk0)
    // the trailing stop moves only at the close of a signal candle (as on the signal chart)
    if trLive and sBar
        float trK = trTight > 0 and (bestP - ent0) * posDir >= trTightR * risk0 ? trTight : trAtr
        float trS = trMode == "Chandelier after +1R" ? bestP - posDir * trK * atr : clS - posDir * trK * atr
        slLvl := posDir > 0 ? math.max(slLvl, trS) : math.min(slLvl, trS)
    if halfOn and not partDone and math.abs(strategy.position_size) < q0 * 0.75
        partDone := true
        slLvl := posDir > 0 ? math.max(slLvl, ent0) : math.min(slLvl, ent0)
    if halfOn and not partDone
        strategy.exit("H" + id, id, qty_percent = 50, stop = slLvl, limit = ent0 + posDir * risk0, comment_loss = "SL", comment_profit = "+1R half")
    strategy.exit("X" + id, id, qty_percent = halfOn ? 50 : 100, stop = slLvl, limit = tpLvl, comment_loss = trLive and (slLvl - ent0) * posDir > 0 ? "Trail" : partDone ? "Break-even" : "SL", comment_profit = "TP")
    if wkExit and lastWkBar
        strategy.close(id, comment = "Friday close")
    else if hold > 0 and held >= hold * 86400000
        strategy.close(id, comment = "Time " + str.tostring(hold) + "d")
    else if flipEx and dir == -posDir
        strategy.close(id, comment = "Direction flip")

// SL / TP zones, like the long/short position tool
if not flat and zonesOn
    int eb = strategy.opentrades.entry_bar_index(0)
    float ep = strategy.opentrades.entry_price(0)
    if eb != zEb
        zEb := eb
        zSl := box.new(eb, math.max(ep, slLvl), bar_index, math.min(ep, slLvl), border_color = color.new(bearC, 30), bgcolor = color.new(bearC, 80))
        zTp := na(tpLvl) ? na : box.new(eb, math.max(ep, tpLvl), bar_index, math.min(ep, tpLvl), border_color = color.new(bullC, 30), bgcolor = color.new(bullC, 80))
    bool locked = (slLvl - ep) * posDir > 0
    box.set_right(zSl, bar_index)
    box.set_top(zSl, math.max(ep, slLvl))
    box.set_bottom(zSl, math.min(ep, slLvl))
    box.set_bgcolor(zSl, locked ? color.new(color.gray, 75) : color.new(bearC, 80))
    box.set_border_color(zSl, locked ? color.new(color.gray, 30) : color.new(bearC, 30))
    if not na(zTp)
        box.set_right(zTp, bar_index)

plot(not flat ? slLvl : na, "Stop", color = color.new(bearC, 20), style = plot.style_linebr)
plot(not flat ? tpLvl : na, "Target", color = color.new(bullC, 20), style = plot.style_linebr)
bgcolor(dir > 0 ? color.new(bullC, 94) : dir < 0 ? color.new(bearC, 94) : na, title = "Direction")

var table tb = table.new(position.bottom_right, 2, 4, bgcolor = color.new(#1E222D, 10), border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, "BE Swing · " + pName, text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, dirMode, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "Bias", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 1, f_bname(b) + " " + f_cname(cv) + " " + f_sg(g), text_color = biasDir > 0 ? bullC : biasDir < 0 ? bearC : color.gray, text_size = size.small)
    table.cell(tb, 0, 2, "Direction now", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 2, dir > 0 ? "long" : dir < 0 ? "short" : "none", text_color = dir > 0 ? bullC : dir < 0 ? bearC : color.gray, text_size = size.small)
    table.cell(tb, 0, 3, "Confirmed", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 3, dir == 0 ? "–" : cfOk ? "yes" : "no", text_color = color.white, text_size = size.small)
if sigTf == "Chart" and timeframe.in_seconds() < 3600 and barstate.islast
    label.new(bar_index, high, "BE Swing reads 4H signals: set 'Signal timeframe' to 4H on this chart.", style = label.style_label_down, color = color.orange, textcolor = color.white)
