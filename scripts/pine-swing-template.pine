// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Forex Fundamental Bias Engine — swing strategy test bench (4H or Daily chart, holds 3–4 days).
// Generated automatically: {{GENERATED}}. Bias data: {{COVERAGE}}.
// Do not edit by hand: the data block is rewritten after every phase and daily check.
// A test bench for your own rules in the Strategy Tester. Not a trade signal.
//@version=6
strategy("Bias Engine · swing test bench", shorttitle = "BE Swing", overlay = true, initial_capital = 10000, pyramiding = 0, process_orders_on_close = true, margin_long = 1, margin_short = 1, commission_type = strategy.commission.percent, commission_value = 0.005, slippage = 0, max_labels_count = 500)

// ───────── settings ─────────
string pairIn  = input.string("Auto", "Pair", options = [{{PAIR_OPTIONS}}], tooltip = "Auto reads the chart symbol (e.g. EURUSD, OANDA:XAUUSD). Built for the 4H chart (Daily works too). Days below are calendar time, so they mean the same on any timeframe.")
string dirMode = input.string("Both must agree", "Direction from", options = ["Fundamental bias", "Price trend (SMA)", "Both must agree"], group = "Direction", tooltip = "Fundamental bias: the week's published bias (data only from the first week in the script). Price trend: close above / below the SMA below, works on years of history, so the mechanics can be tested on thousands of trades. Both: only when the two agree.")
string minConv = input.string("Any", "Minimum conviction", options = ["Any", "Medium or high", "High only"], group = "Direction", tooltip = "Bias modes only. Two-sided weeks never trade.")
int    trLen   = input.int(20, "Trend SMA length (daily closes)", minval = 5, maxval = 400, group = "Direction")
string cfMode  = input.string("Week-to-date", "Price confirmation", options = ["None", "Week-to-date", "Close vs 20-day SMA"], group = "Confirmation", tooltip = "Week-to-date: the day's close is above this week's open for longs (below for shorts); Monday's close is the first that can confirm, so the earliest entry is Tuesday. 20-day SMA: the close is on the trade's side of the 20-day average.")
string enMode  = input.string("A · at the confirming candle's close", "Entry", options = ["A · at the confirming candle's close", "B · pullback to 50% of the confirming candle", "C · break of the confirming candle's high/low"], group = "Entry", tooltip = "The confirming candle is the chart candle (4H) whose close meets direction + confirmation. A: at its close. B: limit order at the middle of its range, valid for the next candle. C: stop order beyond its high (long) / low (short), valid for the next candle.")
bool   noFri   = input.bool(true, "No new entries on Friday", group = "Entry", tooltip = "Fridays would open a trade into the weekend and into next week's new bias.")
int    coolH   = input.int(24, "Hours to wait after an exit", minval = 0, maxval = 240, group = "Entry", tooltip = "No new trade on this pair for this many hours after a trade closes (0 = the next candle).")
string slMode  = input.string("ATR × multiple", "Stop loss", options = ["ATR × multiple", "Beyond the confirming candle's low/high"], group = "Exit")
float  slAtr   = input.float(1.0, "ATR multiple", minval = 0.3, maxval = 5, step = 0.1, group = "Exit")
string atrTf   = input.string("Daily ATR (14)", "ATR from", options = ["Daily ATR (14)", "Chart ATR (14)"], group = "Exit", tooltip = "Daily ATR sizes the stop for a 3–4 day hold whatever the chart timeframe (≈ one normal day's range). Chart ATR on 4H gives a much tighter stop.")
string exMode  = input.string("Half at +1R, rest at break-even", "Exit style", options = ["Half at +1R, rest at break-even", "Fixed (one target)"], group = "Exit", tooltip = "Half at +1R: half the position closes at +1R, the stop of the other half moves to the entry price, and it runs to the take profit below, the time stop or Friday's close. Fixed: the whole position has one stop and one target. Backtest on the USD pairs: the half-at-1R exit cut the worst drawdown from −10R to −4R and was better in both halves of the bias weeks.")
float  tpR     = input.float(3.0, "Take profit (R), 0 = none", minval = 0, maxval = 10, step = 0.5, group = "Exit", tooltip = "For the half-at-1R style this is the target of the second half (tested: 3R). For the fixed style it is the target of the whole position (earlier default: 2R).")
int    hold    = input.int(0, "Time stop: close after this many days (0 = hold to Friday)", minval = 0, maxval = 20, group = "Exit", tooltip = "Tested: hold to Friday with the half-at-1R exit; 4 days with the fixed exit.")
bool   wkExit  = input.bool(true, "Close every trade at Friday's close", group = "Exit")
bool   flipEx  = input.bool(true, "Close if the direction turns against the trade", group = "Exit")
bool   trOn    = input.bool(false, "Trailing stop", group = "Exit")
float  trAtr   = input.float(2.0, "Trailing distance (ATR ×)", minval = 0.5, maxval = 6, step = 0.1, group = "Exit")
int    fromT   = input.time(timestamp("2000-01-01"), "Trade only from this date", group = "Risk", tooltip = "Set it to the first bias week (e.g. 1 Oct 2026) to compare 'Price trend' and 'Fundamental bias' on exactly the same weeks.")
float  stRisk  = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, maxval = 5, step = 0.1, group = "Risk")
color  bullC   = input.color(#22AB94, "Bullish", group = "Colours")
color  bearC   = input.color(#F23645, "Bearish", group = "Colours")

// ───────── data (generated) ─────────
var string[] PAIRS = array.from({{PAIRS}})
var string[] CCY   = array.from({{CCY}})
var int[]    wT = array.new_int()
var string[] wN = array.new_string()
var string[] wD = array.new_string()
var string[] wS = array.new_string()
var int[]    cT = array.new_int()
var string[] cN = array.new_string()
var string[] cD = array.new_string()
var string[] cH = array.new_string()
var string[] cC = array.new_string()
{{DATA}}

// ───────── helpers ─────────
f_item(string row, int i) =>
    string[] parts = str.split(row, ",")
    i >= 0 and i < array.size(parts) ? array.get(parts, i) : "?"
f_bname(string b) => b == "U" ? "BULLISH" : b == "D" ? "BEARISH" : b == "N" ? "TWO-SIDED" : "none"
f_cname(string c) => c == "h" ? "high" : c == "m" ? "medium" : c == "l" ? "low" : "-"
f_sg(float v) => na(v) ? "0" : v > 0 ? "+" + str.tostring(v) : str.tostring(v)
f_sname(string s) => s == "C" ? "Confirmed" : s == "S" ? "Confirmed, could get stronger" : s == "F" ? "Confirmed but fragile" : s == "W" ? "Under watch" : s == "P" ? "Under pressure" : s == "X" ? "Invalidated" : s == "T" ? "Still two-sided" : "none"
f_wa(bool ok) => ok ? "with" : "against"
var string[] DOW = array.from("Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")

// ───────── pair and week ─────────
string symA = syminfo.basecurrency + syminfo.currency
string tk   = str.upper(syminfo.ticker)
string symB = str.length(tk) >= 6 ? str.substring(tk, 0, 6) : tk
int pIdx = pairIn != "Auto" ? array.indexof(PAIRS, pairIn) : array.indexof(PAIRS, symA) >= 0 ? array.indexof(PAIRS, symA) : array.indexof(PAIRS, symB)
string pName = pIdx >= 0 ? array.get(PAIRS, pIdx) : syminfo.ticker
float pipSz = str.contains(pName, "JPY") ? 0.01 : str.contains(pName, "XAU") ? 0.1 : 0.0001
f_pips(float d) => math.round(d / pipSz * 10) / 10

int WEEK_MS = 7 * 86400000
var int wi = -1
while wi + 1 < array.size(wT) and time >= array.get(wT, wi + 1)
    wi += 1
bool inWk = wi >= 0 and time < array.get(wT, math.max(wi, 0)) + WEEK_MS
string rec = inWk and pIdx >= 0 ? f_item(array.get(wD, math.max(wi, 0)), pIdx) : "?"
bool hasRec = rec != "?" and str.length(rec) >= 2
string b  = hasRec ? str.substring(rec, 0, 1) : "-"
string cv = hasRec ? str.substring(rec, 1, 2) : "-"
float  g  = hasRec and str.length(rec) > 2 ? str.tonumber(str.substring(rec, 2)) : na

// latest daily check for this pair up to this bar
var int ci = -1
while ci + 1 < array.size(cT) and time >= array.get(cT, ci + 1)
    ci += 1
string ck = ci >= 0 and pIdx >= 0 ? f_item(array.get(cD, math.max(ci, 0)), pIdx) : "?"
string ckS = ck == "?" or ci < 0 or time - array.get(cT, math.max(ci, 0)) > 3 * 86400000 ? "none" : f_sname(str.substring(ck, 0, 1))

// ───────── direction and confirmation (all known at this day's close) ─────────
// daily values of the previous completed day (no lookahead), so they mean the same on 4H and Daily
[dAtr, smaT, sma20] = request.security(syminfo.tickerid, "D", [ta.atr(14)[1], ta.sma(close, trLen)[1], ta.sma(close, 20)[1]], lookahead = barmerge.lookahead_on)
float cAtr = ta.atr(14)
float atr = atrTf == "Daily ATR (14)" ? dAtr : cAtr
// trading day in New York terms (the FX day starts at 17:00 New York)
int NY7 = 7 * 3600000
int tDay = dayofweek(time + NY7, "America/New_York")
int fri17 = timestamp("America/New_York", year(time + NY7, "America/New_York"), month(time + NY7, "America/New_York"), dayofmonth(time + NY7, "America/New_York"), 17, 0)
bool lastWkBar = tDay == dayofweek.friday and time_close + timeframe.in_seconds() * 1000 > fri17
[wkO, wkT0] = request.security(syminfo.tickerid, "W", [open, time], lookahead = barmerge.lookahead_on)

int biasDir = b == "U" ? 1 : b == "D" ? -1 : 0
bool convOk = minConv == "Any" or (minConv == "High only" ? cv == "h" : cv == "h" or cv == "m")
int bDir = convOk ? biasDir : 0
int tDir = na(smaT) ? 0 : close > smaT ? 1 : close < smaT ? -1 : 0
int dir = dirMode == "Fundamental bias" ? bDir : dirMode == "Price trend (SMA)" ? tDir : (bDir == tDir ? bDir : 0)

bool wtdUp = close > wkO
bool wtdDn = close < wkO
bool smUp = not na(sma20) and close > sma20
bool smDn = not na(sma20) and close < sma20
bool cfOk = cfMode == "None" or (cfMode == "Week-to-date" ? (dir > 0 ? wtdUp : wtdDn) : (dir > 0 ? smUp : smDn))
bool dayOk = not (noFri and tDay == dayofweek.friday) and tDay != dayofweek.saturday and tDay != dayofweek.sunday and not lastWkBar

// ───────── orders ─────────
var float slLvl = na
var float tpLvl = na
var int   lastExitT = 0
var int   posDir = 0
var float ent0 = na
var float risk0 = na
var float q0 = na
var bool  partDone = false
bool halfOn = exMode == "Half at +1R, rest at break-even"
bool flat = strategy.position_size == 0

if not flat and posDir == 0
    posDir := strategy.position_size > 0 ? 1 : -1
    ent0 := strategy.position_avg_price
    risk0 := math.abs(ent0 - slLvl)
    q0 := math.abs(strategy.position_size)
    partDone := false
if flat and posDir != 0
    posDir := 0
    lastExitT := time

// pending orders live one candle
if flat
    strategy.cancel("L")
    strategy.cancel("S")

bool sig = flat and time >= fromT and dir != 0 and cfOk and dayOk and time - lastExitT >= coolH * 3600000 and not na(atr)
if sig
    bool isA = str.startswith(enMode, "A")
    bool isB = str.startswith(enMode, "B")
    float ent = isA ? close : isB ? (high + low) / 2 : (dir > 0 ? high + syminfo.mintick : low - syminfo.mintick)
    float sl = slMode == "ATR × multiple" ? ent - dir * slAtr * atr : (dir > 0 ? low - 0.1 * atr : high + 0.1 * atr)
    float risk = math.abs(ent - sl)
    if risk > 0 and (dir > 0 ? sl < ent : sl > ent)
        float q = strategy.equity * stRisk / 100 / (risk * syminfo.pointvalue)
        string cmt = pName + " | " + (dir > 0 ? "long" : "short") + " | bias " + f_bname(b) + " " + f_cname(cv) + " gap " + f_sg(g) + " | trend " + f_wa(dir == tDir) + " | wtd " + f_wa(dir > 0 ? wtdUp : wtdDn) + " | sma20 " + f_wa(dir > 0 ? smUp : smDn) + " | check " + ckS + " | entry " + str.substring(enMode, 0, 1) + " | SL " + str.tostring(f_pips(risk)) + "p | dir " + dirMode + " | " + array.get(DOW, tDay - 1) + " " + timeframe.period
        string id = dir > 0 ? "L" : "S"
        slLvl := sl
        tpLvl := tpR > 0 ? ent + dir * tpR * risk : na
        if isA
            strategy.entry(id, dir > 0 ? strategy.long : strategy.short, qty = q, comment = cmt)
        else if isB
            strategy.entry(id, dir > 0 ? strategy.long : strategy.short, qty = q, limit = ent, comment = cmt)
        else
            strategy.entry(id, dir > 0 ? strategy.long : strategy.short, qty = q, stop = ent, comment = cmt)
        if halfOn
            strategy.exit("H" + id, id, qty_percent = 50, stop = slLvl, limit = ent + dir * risk, comment_loss = "SL", comment_profit = "+1R half")
            strategy.exit("X" + id, id, qty_percent = 50, stop = slLvl, limit = tpLvl, comment_loss = "SL", comment_profit = "TP")
        else
            strategy.exit("X" + id, id, stop = slLvl, limit = tpLvl, comment_loss = "SL", comment_profit = "TP")

if not flat
    string id = posDir > 0 ? "L" : "S"
    int held = strategy.opentrades > 0 ? time_close - strategy.opentrades.entry_time(0) : 0
    if trOn
        float trS = posDir > 0 ? close - trAtr * atr : close + trAtr * atr
        slLvl := posDir > 0 ? math.max(slLvl, trS) : math.min(slLvl, trS)
    if halfOn and not partDone and math.abs(strategy.position_size) < q0 * 0.75
        partDone := true
        slLvl := posDir > 0 ? math.max(slLvl, ent0) : math.min(slLvl, ent0)
    if halfOn and not partDone
        strategy.exit("H" + id, id, qty_percent = 50, stop = slLvl, limit = ent0 + posDir * risk0, comment_loss = "SL", comment_profit = "+1R half")
    strategy.exit("X" + id, id, qty_percent = halfOn ? 50 : 100, stop = slLvl, limit = tpLvl, comment_loss = partDone ? "Break-even" : trOn ? "SL/trail" : "SL", comment_profit = "TP")
    if wkExit and lastWkBar
        strategy.close(id, comment = "Friday close")
    else if hold > 0 and held >= hold * 86400000
        strategy.close(id, comment = "Time " + str.tostring(hold) + "d")
    else if flipEx and dir == -posDir
        strategy.close(id, comment = "Direction flip")

plot(not flat ? slLvl : na, "Stop", color = color.new(bearC, 20), style = plot.style_linebr)
plot(not flat ? tpLvl : na, "Target", color = color.new(bullC, 20), style = plot.style_linebr)
bgcolor(dir > 0 ? color.new(bullC, 94) : dir < 0 ? color.new(bearC, 94) : na, title = "Direction")

var table tb = table.new(position.bottom_right, 2, 4, bgcolor = color.new(#1E222D, 10), border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, "BE Swing · " + pName, text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, dirMode, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "Bias", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 1, f_bname(b) + " " + f_cname(cv) + " " + f_sg(g), text_color = biasDir > 0 ? bullC : biasDir < 0 ? bearC : color.gray, text_size = size.small)
    table.cell(tb, 0, 2, "Direction now", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 2, dir > 0 ? "long" : dir < 0 ? "short" : "none", text_color = dir > 0 ? bullC : dir < 0 ? bearC : color.gray, text_size = size.small)
    table.cell(tb, 0, 3, "Confirmed", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 3, dir == 0 ? "–" : cfOk ? "yes" : "no", text_color = color.white, text_size = size.small)
if timeframe.in_seconds() < 3600 and barstate.islast
    label.new(bar_index, high, "BE Swing is built for the 4H chart (Daily works too).", style = label.style_label_down, color = color.orange, textcolor = color.white)
